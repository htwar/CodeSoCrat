# Reverse proxy / domain
CODESOCRAT_DOMAIN=cin.sang.com

# PostgreSQL
POSTGRES_DB=codesocrat
POSTGRES_USER=codesocrat
POSTGRES_PASSWORD=CinSang123!
CODESOCRAT_DATABASE_URL=postgresql+psycopg://codesocrat:CinSang123!@db:5432/codesocrat

# App security
CODESOCRAT_SECRET_KEY_CURRENT=CinSangIsTheBest!
CODESOCRAT_SECRET_KEY_PREVIOUS=
CODESOCRAT_CORS_ORIGINS=https://cin.sang.com
CODESOCRAT_SESSION_COOKIE_NAME=codesocrat_session
CODESOCRAT_CSRF_COOKIE_NAME=codesocrat_csrf
CODESOCRAT_CSRF_HEADER_NAME=X-CSRF-Token
CODESOCRAT_SESSION_COOKIE_SECURE=true
CODESOCRAT_SESSION_COOKIE_SAMESITE=lax
CODESOCRAT_SESSION_COOKIE_MAX_AGE_SECONDS=604800

# Sandbox
CODESOCRAT_DOCKER_IMAGE=python:3.11-alpine
CODESOCRAT_DOCKER_AUTO_PULL=true
CODESOCRAT_DOCKER_PULL_TIMEOUT_SECONDS=120
CODESOCRAT_DOCKER_CPUS=0.5
CODESOCRAT_DOCKER_PIDS_LIMIT=64

# Ollama
CODESOCRAT_OLLAMA_BASE_URL=http://host.docker.internal:11434
CODESOCRAT_OLLAMA_MODEL=qwen2.5-coder:14b
CODESOCRAT_OLLAMA_TIMEOUT_SECONDS=30
CODESOCRAT_OLLAMA_KEEP_ALIVE=10m
CODESOCRAT_OLLAMA_HINT_MAX_TOKENS=120

# Rate limiting
CODESOCRAT_RATE_LIMIT_WINDOW_SECONDS=60
CODESOCRAT_RATE_LIMIT_IP_PUBLIC=60
CODESOCRAT_RATE_LIMIT_IP_AUTHENTICATED=120
CODESOCRAT_RATE_LIMIT_USER_AUTHENTICATED=90
CODESOCRAT_LOGIN_RATE_LIMIT_IP=10
CODESOCRAT_LOGIN_RATE_LIMIT_USER=5
